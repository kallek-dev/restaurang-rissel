# Databas (Postgres). Skapas enklast via Vercel → Storage → Create
# Database → Postgres — då fylls den här i automatiskt hos Vercel.
# Lokalt: klistra in samma värde här, eller peka på en egen Postgres-db.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Mailjet (mail) — skapa konto på https://mailjet.com, lägg till en
# verifierad avsändaradress under Senders & Domains → "Add a sender
# address" (ingen egen domän behövs, bara en mailadress ni bekräftar
# via en länk som skickas dit). API-nycklarna hittar ni under
# Account Settings → API Key Management. OBS: Mailjet kräver TVÅ
# nycklar, inte en enda.
MJ_APIKEY_PUBLIC=""
MJ_APIKEY_PRIVATE=""
# Måste vara exakt den mailadress ni verifierade ovan.
MJ_FROM_EMAIL="Restaurang Rissel <dinadress@gmail.com>"

# Hemlighet som skyddar /api/cron/reminders och /api/cron/cleanup från
# att triggas av vem som helst.
CRON_SECRET="valfri-lång-slumpad-sträng"

# Lösenord för adminpanelen (/admin). Obligatorisk i produktion — utan
# den är adminpanelen avstängd, inte öppen.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="byt-till-ett-eget-starkt-lösenord"

# Fullständig webbadress till sajten (utan avslutande /), används för att
# bygga avbokningslänkar i mail. På Vercel fylls detta i automatiskt av
# VERCEL_URL om du inte sätter den själv — men sätt den gärna ändå till
# din riktiga .vercel.app-adress (eller egen domän) för att slippa
# beroendet av interna förhandsgranskningsadresser.
NEXT_PUBLIC_SITE_URL="https://restaurang-rissel.vercel.app"

