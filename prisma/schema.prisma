// Databasschema för Restaurang Rissels bokningssystem.
//
// Provider är satt till "postgresql" eftersom projektet driftsätts på
// Vercel med en Postgres-databas (t.ex. Neon via Vercel Storage).
// DATABASE_URL sätts som miljövariabel, se README.md.

generator client {
  provider      = "prisma-client-js"
  // "native" täcker din lokala dator. De två rhel-målen täcker Netlifys
  // (och AWS Lambdas) serverless-körmiljö — utan dem har Prisma historiskt
  // byggt fel databasmotor på Netlify och kraschat i produktion.
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enda raden (id = 1) med alla inställningar för restaurangen.
// Redigeras via adminpanelen, ingen kodändring krävs.
model Settings {
  id Int @id @default(autoincrement())

  // Huvudbrytare: stänger hela bokningssystemet för gäster.
  systemOpen Boolean @default(true)

  // Vilka dagar restaurangen är öppen styrs numera av OpenPeriod
  // (terminer/perioder med en veckoregel) + DateException (undantag,
  // t.ex. praktikveckor) — inte av ett fast fält här längre. Utanför
  // alla perioder är det stängt per automatik. Se OpenPeriod nedan.

  // Sittningstider, t.ex. ["11:30","12:30"]
  sittingsJson String @default("[\"11:30\",\"12:30\"]")

  // Hur långt (minuter) efter varje sittningstid som kvartsslottar skapas.
  // T.ex. 60 min från 11:30 ger slottar 11:30, 11:45, 12:00, 12:15.
  sittingWindowMinutes Int @default(60)

  // Intervall mellan bokningsbara tider, i minuter.
  slotIntervalMinutes Int @default(15)

  // Max antal bord som får sitta ner under samma kvart, oavsett typ.
  // Finjustering per bordstyp (t.ex. max 2 fyrbord samtidigt) görs i
  // stället via maxPerSlot på respektive bordstyp, se tableTypesJson.
  maxTablesPerSlot Int @default(4)

  // Bordstyper, t.ex.
  // [{"id":"small","label":"Bord för 2","seats":2,"minPeople":1,"count":6},
  //  {"id":"large","label":"Bord för 4","seats":4,"minPeople":2,"count":7}]
  tableTypesJson String @default("[{\"id\":\"small\",\"label\":\"Bord för 2\",\"seats\":2,\"minPeople\":1,\"count\":6},{\"id\":\"large\",\"label\":\"Bord för 4\",\"seats\":4,\"minPeople\":2,\"count\":7}]")

  // Största sällskap som får boka direkt i systemet. Större sällskap
  // hänvisas till att maila restaurangen istället.
  maxOnlinePartySize Int @default(4)

  // Mailadress som visas för frågor och för stora sällskap.
  contactEmail String @default("info@restaurangrissel.se")

  // GDPR: hur många månader en bokning (med namn, mail, telefon,
  // ev. allergier) sparas innan den raderas automatiskt.
  // Se /api/cron/cleanup och README → "GDPR".
  retentionMonths Int @default(12)

  restaurantName String @default("Restaurang Rissel")

  updatedAt DateTime @updatedAt
}

model Booking {
  id String @id @default(cuid())

  date        String // ISO-datum, "2026-09-01"
  sitting     String  @default("") // Vad gästen valde: "11:30" eller "12:30"
  timeSlot    String // Faktisk tilldelad ankomsttid inom sittningen, t.ex. "11:45"
  partySize   Int
  tableTypeId String // matchar id i Settings.tableTypesJson

  name      String
  email     String
  phone     String
  allergies String @default("")

  // Måste vara true om "allergies" innehåller text — gästen har då
  // aktivt godkänt att uppgiften sparas (känsligare personuppgift).
  allergyConsent Boolean @default(false)

  // confirmed | cancelled
  status String @default("confirmed")

  // Fritext-anteckning från admin, t.ex. "Bord 3+4 ihopskjutna".
  note String @default("")

  // True om bokningen skapades av admin (manuellt, telefon, eller
  // inbokning av en förfrågan) istället för av gästen själv online.
  createdByAdmin Boolean @default(false)

  // Slumpad hemlighet i avbokningslänken i mailet — gör att en gäst kan
  // avboka sig själv utan inloggning, utan att kunna gissa sig till
  // andra gästers bokningar. Nullable så att kolumnen kan läggas till
  // ovanpå redan befintliga bokningar utan att krocka med unikhetskravet
  // (nya bokningar får alltid ett riktigt värde, se createBooking).
  cancelToken String? @unique

  reminderSentAt DateTime?

  createdAt DateTime @default(now())

  @@index([date, sitting])
  @@index([date, status])
}

// Förfrågan från gäster med sällskap större än maxOnlinePartySize —
// dessa bokas inte automatiskt (kräver oftast särskild bordslösning)
// utan hanteras av admin under fliken "Förfrågningar".
model GroupRequest {
  id String @id @default(cuid())

  date      String // önskat datum
  sitting   String // önskad sittning, eller fritext om osäker
  partySize Int

  name    String
  email   String
  phone   String
  message String @default("")

  // pending | handled
  status String @default("pending")

  // Om admin bokat in förfrågan som en riktig bokning, kopplingen dit.
  linkedBookingId String?

  createdAt DateTime @default(now())

  @@index([status])
}

// En period (t.ex. en termin) då restaurangen är öppen enligt en
// veckoregel. Utanför alla perioder är det stängt per automatik — inget
// att komma ihåg att stänga manuellt inför lov.
model OpenPeriod {
  id String @id @default(cuid())

  startDate String // "2026-08-18"
  endDate   String // "2026-12-19"

  // Vilka veckodagar som är öppna INOM perioden. 0=sön ... 6=lör.
  weekdaysJson String // "[2,3,5]"

  // Valfri anteckning, t.ex. "HT2026".
  note String @default("")

  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

// Undantag från den vanliga veckoregeln för ett datumintervall — antingen
// en stängning inuti en öppen period (t.ex. en praktikvecka) eller en
// extra öppning (t.ex. ett specialtillfälle). En enskild dag är bara ett
// intervall där startDate = endDate. Undantag vinner alltid över
// OpenPeriod-regeln för de datum de täcker.
model DateException {
  id String @id @default(cuid())

  startDate String
  endDate   String

  // true = extra öppet, false = stängt (vanligast).
  isOpen Boolean

  note String @default("")

  createdAt DateTime @default(now())

  @@index([startDate, endDate])
}

// Väntelista för fullbokade tider. Vid avbokning meddelas den som
// väntat längst (vars sällskap får plats) via mail med en länk för att
// slutföra bokningen.
model WaitlistEntry {
  id String @id @default(cuid())

  date      String
  timeSlot  String // exakt önskad tid, samma som en vanlig bokning
  partySize Int

  name  String
  email String
  phone String

  // waiting | notified | booked | expired
  status String @default("waiting")

  // Slumpad hemlighet i länken i meddelande-mailet.
  claimToken String @unique

  notifiedAt DateTime?
  createdAt  DateTime @default(now())

  @@index([date, timeSlot, status])
}
